datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum LLMStatus {
  SUCCESS
  FAILED
  FALLBACK
}

enum EmailType {
  BOOKING_CONFIRM
  REMINDER
  CANCELLATION
  LEAVE_NOTICE
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               Role
  name               String
  phone              String?
  createdAt          DateTime @default(now())
  isActive           Boolean  @default(true)
  googleAccessToken  String?
  googleRefreshToken String?

  // Relations
  doctorProfile DoctorProfile?
  appointments  Appointment[]        @relation("PatientAppointments")
  reminders     MedicationReminder[]
  holds         SlotHold[]
}

model DoctorProfile {
  userId              String @id
  specialization      String
  bio                 String
  workingHours        Json // array of weekday slots: { weekday: number, start: string, end: string }
  slotDurationMinutes Int    @default(30)
  consultationFee     Float // consultation fee

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves       DoctorLeave[]
  appointments Appointment[]      @relation("DoctorAppointments")
  holds        SlotHold[]
  conflictLogs LeaveConflictLog[]
}

model DoctorLeave {
  id       String   @id @default(uuid())
  doctorId String
  date     DateTime
  reason   String?

  // Relations
  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)

  @@index([doctorId])
  @@index([date])
}

model Appointment {
  id                           String            @id @default(uuid())
  patientId                    String
  doctorId                     String
  slotStart                    DateTime
  slotEnd                      DateTime
  status                       AppointmentStatus @default(HELD)
  createdAt                    DateTime          @default(now())
  googleCalendarEventIdPatient String?
  googleCalendarEventIdDoctor  String?

  // Relations
  patient          User                 @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor           DoctorProfile        @relation("DoctorAppointments", fields: [doctorId], references: [userId], onDelete: Cascade)
  symptomForm      SymptomForm?
  preVisitSummary  PreVisitSummary?
  postVisitNote    PostVisitNote?
  postVisitSummary PostVisitSummary?
  reminders        MedicationReminder[]
  // Custom unique partial index (doctorId, slotStart) WHERE status != 'CANCELLED' will be added via raw SQL migration.

  @@index([patientId])
  @@index([doctorId])
  @@index([slotStart])
}

model SymptomForm {
  appointmentId String   @id
  symptomsText  String
  submittedAt   DateTime @default(now())

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model PreVisitSummary {
  appointmentId      String       @id
  urgencyLevel       UrgencyLevel
  chiefComplaint     String
  suggestedQuestions Json // array of string
  rawLLMResponse     String
  generatedAt        DateTime     @default(now())
  status             LLMStatus

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model PostVisitNote {
  appointmentId    String   @id
  clinicalNotes    String
  prescriptionJSON Json // array of { medicine, dosage, frequency, durationDays }
  generatedAt      DateTime @default(now())

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model PostVisitSummary {
  appointmentId       String    @id
  patientFriendlyText String
  medicationSchedule  Json // array of { medicine, dosage, frequency, durationDays, instructions }
  followUpSteps       Json // array of string
  status              LLMStatus
  generatedAt         DateTime  @default(now())

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model MedicationReminder {
  id            String    @id @default(uuid())
  appointmentId String
  patientId     String
  medicine      String
  scheduledTime DateTime
  sent          Boolean   @default(false)
  sentAt        DateTime?

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([scheduledTime])
}

model EmailLog {
  id            String      @id @default(uuid())
  toEmail       String
  type          EmailType
  status        EmailStatus @default(QUEUED)
  retryCount    Int         @default(0)
  lastAttemptAt DateTime?
  payload       Json
  createdAt     DateTime    @default(now())

  @@index([status])
}

model SlotHold {
  id        String   @id @default(uuid())
  doctorId  String
  slotStart DateTime
  slotEnd   DateTime
  patientId String
  expiresAt DateTime

  // Relations
  doctor  DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  patient User          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([doctorId, slotStart])
}

model LeaveConflictLog {
  id                    String   @id @default(uuid())
  doctorId              String
  leaveDate             DateTime
  cancelledAppointments Json // array of appointment metadata
  loggedAt              DateTime @default(now())

  // Relations
  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
}
